# true = serve admin screens from in-browser mock data (admin endpoints not built yet in Olga.Core)
VITE_USE_MOCKS=true

# Local dev: leave VITE_CORE_API_URL empty so requests go through the Vite proxy below.
VITE_CORE_API_URL=
# Where the Vite dev server proxies /v1, /ready and /health (your locally running Olga.Core API)
CORE_API_PROXY_TARGET=http://localhost:5000
